# Run from repository root. Export variables or use your shell's env loader.
HALO_HOST=127.0.0.1
HALO_PORT=3001
HALO_DB_PATH=backend/var/halo.sqlite
HALO_ALLOWED_ORIGINS=http://localhost:5173
# Required when binding beyond loopback. Enter in browser Settings; do not bundle in Vite.
HALO_API_TOKEN=
# Optional. No credentials are required for offline/default functionality.
AI_API_KEY=
HALO_MODEL=
# Node24 proxy environments may require NODE_USE_ENV_PROXY=1.

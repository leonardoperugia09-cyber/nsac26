# Use the root .env.example: npm run server loads the root .env if present.
HALO_HOST=127.0.0.1
HALO_PORT=3001
HALO_DB_PATH=backend/var/halo.sqlite
HALO_ALLOWED_ORIGINS=http://localhost:5173
# Required when binding beyond loopback. Enter in browser Settings; do not bundle in Vite.
HALO_API_TOKEN=
# Server-only hosted AI. Both values and browser session consent are required.
# See backend/docs/ASSISTANT.md. Never use VITE_ prefixes for these.
AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# Direct OpenAI alternative: AI_PROVIDER=openai
AI_API_KEY=
HALO_MODEL=
# Node24 proxy environments may require NODE_USE_ENV_PROXY=1.

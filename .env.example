# Copy to .env at the repository root; never commit credentials.
# Server-only. Azure setup: backend/docs/AZURE.md.
AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# For direct OpenAI instead: AI_PROVIDER=openai and set these two values.
AI_API_KEY=
HALO_MODEL=
# For Claude (Anthropic) instead: AI_PROVIDER=anthropic, set the key, and leave
# HALO_MODEL empty to use the default claude-opus-5-5. See backend/docs/ASSISTANT.md.
ANTHROPIC_API_KEY=
HALO_HOST=127.0.0.1
HALO_PORT=3001
HALO_DB_PATH=backend/var/halo.sqlite
HALO_API_TOKEN=
HALO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional PUBLIC frontend API address, including /api. A rebuild is required.
# VITE_API_BASE_URL=https://YOUR-API-HOST/api
